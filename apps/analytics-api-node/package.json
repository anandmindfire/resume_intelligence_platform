{
  "name": "@resume-platform/analytics-api",
  "version": "1.0.0",
  "description": "Analytics API for dashboard",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "clean": "rm -rf dist *.tsbuildinfo",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fastify/cors": "^8.4.0",
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/swagger": "^8.15.0",
    "@fastify/swagger-ui": "^4.2.0",
    "@resume-platform/config": "*",
    "@resume-platform/logger": "*",
    "fastify": "^4.24.3",
    "pg": "^8.11.3",
    "@resume-platform/http-kit": "*"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.10.9",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.2"
  }
}
