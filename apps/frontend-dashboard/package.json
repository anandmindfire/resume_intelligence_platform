{
  "name": "@resume-platform/frontend-dashboard",
  "version": "1.0.0",
  "description": "Frontend dashboard for Resume Intelligence Platform",
  "private": true,
  "dependencies": {
    "apexcharts": "^4.0.0",
    "axios": "^1.6.2",
    "lucide-react": "^0.294.0",
    "oidc-client-ts": "^3.5.0",
    "react": "^18.2.0",
    "react-apexcharts": "^1.9.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.2.3",
    "react-router-dom": "^6.20.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.2.42",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.32",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.2",
    "vite": "^5.0.7"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:analyze": "tsc && ANALYZE=true vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit",
    "type-check:test": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --max-warnings 0"
  }
}
